# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit it.

# --- Gmail -------------------------------------------------------------------
#
# Create a project at https://console.cloud.google.com, enable the Gmail API,
# configure the OAuth consent screen, then create credentials of type
# "OAuth client ID" -> "Desktop app".
#
# For a Desktop OAuth client these values are public per RFC 8252. They identify
# the app; they do not grant access to your mailbox on their own. The refresh
# token is the real credential and is stored in Windows Credential Manager
# through keyring, never in this file.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Groq --------------------------------------------------------------------
#
# Unlike the Gmail client ID and secret above, this key IS a real credential.
# The app reads it from Windows Credential Manager first and only falls back to
# the value here, so you can move it out of this file with Settings -> Groq ->
# "Move key to Credential Manager".

GROQ_API_KEY=your-groq-api-key-here

# Groq model used for pre-labeling (override if needed).
GROQ_MODEL=llama-3.3-70b-versatile

# Optional pacing overrides. The defaults stay under the free tier's 30 requests
# per minute and 12,000 tokens per minute; the token ceiling is the binding one,
# so requests are spaced rather than sent in a burst.
GROQ_REQUESTS_PER_MINUTE=12

# Classifications at or above this confidence apply the status automatically.
# Anything below it only pre-fills the dropdown for you to confirm.
GROQ_CONFIDENCE_THRESHOLD=0.85

# --- Anthropic (research and resume generation) ------------------------------
#
# The second model in the system. Groq above does the high-volume classification
# on the free tier; Claude does the low-volume, high-value work - researching a
# company with web search, then tailoring a resume and CV to the posting.
#
# The app runs without this: research is skipped and leads simply wait
# unprepared. Like the Groq key, it is read from the OS credential store first
# and only falls back to the value here.

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5

# Daily ceiling on research output tokens. Output is the expensive half, so
# capping it caps the bill - roughly $2.50/day at this value. This is a
# backstop against a parser bug turning one alert email into hundreds of leads,
# not a budget you are expected to hit.
RESEARCH_DAILY_OUTPUT_TOKENS=100000

# --- Ingest pipeline ---------------------------------------------------------
#
# How often the background poller runs, in seconds. Gmail quota is not the
# constraint at personal-mailbox scale; 600 is comfortable.

JOB_BUILDER_POLL_SECONDS=600

# OAuth consent redirect port. Pinned rather than random so it can be forwarded
# from a desktop when connecting Gmail on a headless server:
#     ssh -L 8765:localhost:8765 <server>
GMAIL_OAUTH_PORT=8765

# --- Secrets backend ---------------------------------------------------------
#
# "keyring" (default) uses the OS credential store - Windows Credential
# Manager, gnome-keyring, macOS Keychain.
#
# "file" writes a 0600 JSON file instead, for a headless server with no secret
# service running. Opt-in on purpose: nobody should end up with a Gmail refresh
# token on disk without having chosen it.

# JOB_BUILDER_SECRETS=file
# JOB_BUILDER_SECRETS_PATH=~/.config/job_builder/credentials.json

# --- Logging -----------------------------------------------------------------

# JOB_BUILDER_LOG_LEVEL=INFO
