# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit it.

# --- Gmail -------------------------------------------------------------------
#
# Create a project at https://console.cloud.google.com, enable the Gmail API,
# configure the OAuth consent screen, then create credentials of type
# "OAuth client ID" -> "Desktop app".
#
# For a Desktop OAuth client these values are public per RFC 8252. They identify
# the app; they do not grant access to your mailbox on their own. The refresh
# token is the real credential and is stored in Windows Credential Manager
# through keyring, never in this file.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Groq --------------------------------------------------------------------
#
# Unlike the Gmail client ID and secret above, this key IS a real credential.
# The app reads it from Windows Credential Manager first and only falls back to
# the value here, so you can move it out of this file with Settings -> Groq ->
# "Move key to Credential Manager".

GROQ_API_KEY=your-groq-api-key-here

# Groq model used for pre-labeling (override if needed).
GROQ_MODEL=llama-3.3-70b-versatile

# Optional pacing overrides. The defaults stay under the free tier's 30 requests
# per minute and 12,000 tokens per minute; the token ceiling is the binding one,
# so requests are spaced rather than sent in a burst.
GROQ_REQUESTS_PER_MINUTE=12

# Classifications at or above this confidence apply the status automatically.
# Anything below it only pre-fills the dropdown for you to confirm.
#
# Lives here for historical reasons but is not a Groq setting: the threshold is
# a property of the classification, and every model that produces a label is
# held to the same bar. Prefer LLM_CONFIDENCE_THRESHOLD below; this name is
# still read, so an existing .env keeps working.
GROQ_CONFIDENCE_THRESHOLD=0.85

# The provider-neutral name for the same thing. Wins when both are set.
# LLM_CONFIDENCE_THRESHOLD=0.85

# --- Gemini ------------------------------------------------------------------
#
# The second engine. It does the same classification work as Groq when Groq's
# allowance is spent, so hitting a rate limit part-way through a batch moves the
# work rather than ending the cycle - and it is the *primary* for research,
# where it uses Google Search grounding.
#
# Optional. Leave the placeholder below in place to run without it: it counts as
# "not configured" the same way the Groq placeholder does, and each task falls
# back to whatever else is routed to it. Get a key at
# https://aistudio.google.com/apikey.
#
# Like the Groq key this is a real credential, not a public client identifier.
# It is read from the OS credential store first and only falls back to the value
# here, so you can move it out of this file from Settings.

GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used for pre-labeling (override if needed).
#
# Pinned to a specific version rather than the `gemini-flash-latest` alias.
# That alias is hot-swapped on every release, so a classifier's behaviour would
# change with no commit behind it and no way to correlate the change with the
# labels it produced.
GEMINI_MODEL=gemini-3.6-flash

# Optional pacing overrides. Same meaning as the Groq pair above, sized for a
# different free tier: here the request ceiling binds first, not the token
# ceiling, which is roomy enough that classification never approaches it.
GEMINI_REQUESTS_PER_MINUTE=8
GEMINI_TOKENS_PER_MINUTE=250000

# Gemini also caps requests per day, which Groq's per-minute limits do not.
# That ceiling is the one a fallback provider actually runs into, and it is why
# requests spread out as the day's allowance is used up rather than running
# flat out until they stop. 0 disables the daily check.
GEMINI_REQUESTS_PER_DAY=1200

# Free-tier limits are per project and move; Google publishes yours in AI
# Studio rather than in the docs, so treat the three values above as
# conservative starting points and raise them once you have seen your own:
#     https://aistudio.google.com/rate-limit
# The daily quota resets at midnight Pacific. This app counts a rolling 24
# hours instead, which is stricter from every timezone.

# Which grounding tool the research call declares. Models before 2.0 spell it
# `google_search_retrieval`. Configured rather than guessed from the model name,
# because the wrong key returns an ungrounded answer that looks perfectly fine.
# GEMINI_SEARCH_TOOL=google_search

# --- Claude Code CLI ---------------------------------------------------------
#
# Runs the locally installed `claude` binary headlessly instead of calling an
# HTTP API. Nothing routes here unless you point a task at it below or from
# Settings -> Task routing: one call is an agent loop taking tens of seconds,
# where Groq answers in under a second. Research is where it earns that - it
# gets live web search, which is what makes the result grounded rather than
# remembered.
#
# Configuration is discovery, not secrets: install the CLI, run `claude` once to
# sign in, and it is configured.
#
# On authentication: without CLAUDE_CLI_BARE the CLI uses your signed-in
# subscription. Anthropic's documentation asks developers building on the Agent
# SDK to use API-key authentication, and states that Pro/Max limits assume
# ordinary individual use. Set CLAUDE_CLI_BARE=1 and ANTHROPIC_API_KEY to run
# that way instead.

# Full path to the binary. Leave unset to find `claude` on PATH.
# CLAUDE_CLI_PATH=

# Model id or alias (sonnet, opus, haiku). Unset accepts the CLI's own default.
# CLAUDE_CLI_MODEL=

# Where the subprocess runs. This is a safety setting, not a preference: the
# CLI loads CLAUDE.md, hooks and MCP config from its working directory, so it
# is deliberately kept away from any real project. Defaults to
# ~/.job_builder/claude_cli.
# CLAUDE_CLI_WORKDIR=

# Wall-clock ceiling per call, in seconds. Research gets a longer default.
# CLAUDE_CLI_TIMEOUT=90

# Per-call spend cap in dollars, passed to --max-budget-usd. 0 sends no cap.
# CLAUDE_CLI_MAX_BUDGET_USD=0

# Daily request ceiling. 0, the default, means no ceiling.
# CLAUDE_CLI_REQUESTS_PER_DAY=0

# Set to 1 to pass --bare: skips CLAUDE.md, hooks, plugins and MCP discovery,
# and switches to ANTHROPIC_API_KEY instead of the subscription login.
# CLAUDE_CLI_BARE=0

# --- Which model does which job ----------------------------------------------
#
# Every model call in the app is a named task, and each task has an ordered list
# of providers to try. The first that is configured, is not cooling down from a
# rate limit, and has daily allowance left takes the call; the next one picks it
# up otherwise. Settings -> Task routing edits this in the app, and anything set
# there wins over the values here.
#
# Values are comma-separated provider names: groq, gemini, anthropic,
# claude_cli. Use "none" to switch a task off entirely.
#
# The defaults, if you set nothing:
#
#   LLM_ROUTE_ROUTE_EMAIL=groq,gemini
#   LLM_ROUTE_EXTRACT_ALERT=groq,gemini
#   LLM_ROUTE_EXTRACT_UPDATE=groq,gemini
#   LLM_ROUTE_EXTRACT_ACKNOWLEDGEMENT=groq,gemini
#   LLM_ROUTE_SCORE_RELEVANCE=groq,gemini
#   LLM_ROUTE_CLASSIFY_REPLY=groq,gemini
#   LLM_ROUTE_RESEARCH=gemini,anthropic
#
# Research defaults to Gemini first because it is free and grounded in Google
# Search; Claude picks up what is left, and its daily spend ceiling below still
# applies when it does.

# Consulted when nothing in a task's list can take the call. Groq rather than
# Gemini, because Groq has no daily ceiling to be locked out of - a per-minute
# limit always clears, so there is always something to wait for.
# LLM_DEFAULT_PROVIDER=groq

# --- Anthropic (research and resume generation) ------------------------------
#
# The paid option, and now the fallback rather than the only researcher. Gemini
# above researches first on its free tier; Claude picks up what is left, which
# is the case its daily ceiling below exists for.
#
# The app runs without this: research falls to Gemini alone, and if that is
# unconfigured too, leads simply wait unprepared. Like the Groq key, it is read
# from the OS credential store first and only falls back to the value here.

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5

# Daily ceiling on research output tokens. Output is the expensive half, so
# capping it caps the bill - roughly $2.50/day at this value. This is a
# backstop against a parser bug turning one alert email into hundreds of leads,
# not a budget you are expected to hit.
RESEARCH_DAILY_OUTPUT_TOKENS=100000

# --- Ingest pipeline ---------------------------------------------------------
#
# How often the background poller runs, in seconds. Gmail quota is not the
# constraint at personal-mailbox scale; 600 is comfortable.

JOB_BUILDER_POLL_SECONDS=600

# OAuth consent redirect port. Pinned rather than random so it can be forwarded
# from a desktop when connecting Gmail on a headless server:
#     ssh -L 8765:localhost:8765 <server>
GMAIL_OAUTH_PORT=8765

# --- Documents ---------------------------------------------------------------
#
# The master resume, a real LaTeX document you edit by hand. Its preamble,
# contact block, Education and Skills sections are reproduced verbatim; only
# Experience and Projects are regenerated per application, from the bullets in
# the Resume page. Without this, the Resume button has nothing to build from.

# JOB_BUILDER_RESUME_MASTER=/path/to/your/resume/main.tex

# The cover letter template. Defaults to templates/cover_letter.tex in this
# repo, which is deliberately plain - set this only if you want your own.

# JOB_BUILDER_COVER_MASTER=/path/to/cover_letter.tex

# Where a generated document lands. Defaults to your Downloads folder.

# JOB_BUILDER_DOWNLOAD_DIR=~/Downloads

# Which LaTeX engine compiles the PDF. By default the first of tectonic,
# latexmk, xelatex, pdflatex found on PATH is used. With none installed the
# button still works and delivers the .tex, which compiles as-is on Overleaf.
#
# Tectonic is the easiest to add: a single binary that fetches the packages it
# needs on first run, rather than a multi-gigabyte TeX Live install.

# JOB_BUILDER_LATEX_ENGINE=tectonic

# --- Secrets backend ---------------------------------------------------------
#
# "keyring" (default) uses the OS credential store - Windows Credential
# Manager, gnome-keyring, macOS Keychain.
#
# "file" writes a 0600 JSON file instead, for a headless server with no secret
# service running. Opt-in on purpose: nobody should end up with a Gmail refresh
# token on disk without having chosen it.

# JOB_BUILDER_SECRETS=file
# JOB_BUILDER_SECRETS_PATH=~/.config/job_builder/credentials.json

# --- Logging -----------------------------------------------------------------

# JOB_BUILDER_LOG_LEVEL=INFO
